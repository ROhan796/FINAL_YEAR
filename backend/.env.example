# ── Core ────────────────────────────────────────────────────────────────────
APP_NAME="AI Scientific Paper Knowledge Engine"
APP_ENV="dev"                       # dev | staging | prod
APP_DEBUG=true
APP_BASE_URL="http://localhost:8000"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Database (NeonDB in staging/prod) ───────────────────────────────────────
# Neon: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/ckgai"
DATABASE_URL_READONLY=""             # optional Neon read replica; falls back to DATABASE_URL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Vector search ───────────────────────────────────────────────────────────
EMBEDDING_DIM=768
PAPER_ENCODER="specter2"             # specter2 | scibert | pubmedbert
PASSAGE_ENCODER="scibert"
SEARCH_DEFAULT_MODE="hybrid"
SEARCH_TOP_K=100
SEARCH_PAGE_SIZE=20
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=100

# ── Graph (Neo4j is a PROJECTED read model; Postgres is source of truth) ────
NEO4J_ENABLED=false
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"
GRAPH_PROJECTOR_BATCH=1000

# ── Cache / queue ───────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
CACHE_ENABLED=true
CACHE_TTL_SEARCH=300
CACHE_TTL_FEED=60
CACHE_TTL_QUERY_EMBEDDING=86400
QUEUE_ENABLED=true

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
DEV_AUTO_LOGIN=true                  # dev only: serve the seeded user with no token

# ── LLM provider (gemini | openai | fallback) ───────────────────────────────
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048

# ── ML plane ────────────────────────────────────────────────────────────────
ML_ENABLED=true
ML_DEVICE="auto"                     # auto | cpu | cuda
ML_CHECKPOINT_DIR="./models/checkpoints"
ML_NER_MODEL="allenai/scibert_scivocab_uncased"
ML_RELATION_MODEL="allenai/scibert_scivocab_uncased"
ML_ENTITY_RESOLUTION_THRESHOLD=0.92

# ── CKGAI hyperparameters (spec appendix) ───────────────────────────────────
GNN_LAYERS=3
GNN_HIDDEN_DIM=256
GNN_RGCN_BASES=30
GNN_GAT_HEADS=8
GNN_DROPOUT=0.1
GNN_LEARNING_RATE=0.001
GNN_BATCH_SIZE=1024
GNN_NEGATIVE_SAMPLES=5
GNN_MARGIN=1.0
DISCOVERY_SCORER="distmult"          # distmult | transe | dot | mlp
DISCOVERY_CROSS_DOMAIN_BOOST=1.3
DISCOVERY_TOP_K=100

# ── Ingestion ───────────────────────────────────────────────────────────────
ARXIV_ENABLED=true
PUBMED_ENABLED=true
SEMANTIC_SCHOLAR_ENABLED=true
SEMANTIC_SCHOLAR_API_KEY=""
INGEST_RATE_LIMIT_SECONDS=3.0
OBJECT_STORAGE_URL=""

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"                    # json | console
OTEL_ENABLED=false
